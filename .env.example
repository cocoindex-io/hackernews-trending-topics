# Local file holding CocoIndex's own incremental-processing state (v1 engine).
COCOINDEX_DB=./cocoindex.db

# Postgres connection for the hn_messages / hn_topics target tables.
POSTGRES_URL=postgres://cocoindex:cocoindex@localhost/cocoindex

# LLM used to extract topics. Any LiteLLM-supported model works; set the
# matching provider key below. Defaults to gemini/gemini-2.5-flash.
# LLM_MODEL=gemini/gemini-2.5-flash
GEMINI_API_KEY=
# LLM_MODEL=openai/gpt-5-mini
# OPENAI_API_KEY=

# Number of recent HN threads to index per run.
# MAX_THREADS=10
